{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Fireweave",
  "description": "Fireweave is an AI release engineer. Developer docs: SDKs for Node, Python, Go, Java, Rust, and the browser, plus onboarding for the CLI, Terraform, and coding-agent plugins.",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "appearance": {
    "default": "system"
  },
  "navigation": {
    "groups": [
      {
        "group": "Get Started",
        "pages": [
          "index",
          "for-coding-agents",
          "onboarding",
          "onboarding/setup",
          "onboarding/first-change",
          "introduction/how-it-works",
          "introduction/architecture",
          "quickstart"
        ]
      },
      {
        "group": "SDKs",
        "pages": [
          "sdks/node",
          "sdks/python",
          "sdks/go",
          "sdks/java",
          "sdks/rust",
          "sdks/web",
          "sdks/compatibility"
        ]
      },
      {
        "group": "Concepts",
        "pages": [
          "concepts",
          "concepts/control-points",
          "concepts/targeting",
          "concepts/adapters",
          "concepts/releases",
          "concepts/exposures",
          "concepts/signals",
          "concepts/capabilities"
        ]
      },
      {
        "group": "Production",
        "pages": [
          "production/configuration",
          "production/lifecycle",
          "production/errors"
        ]
      },
      {
        "group": "CLI",
        "pages": [
          "cli/overview",
          "cli/authentication",
          "cli/commands"
        ]
      },
      {
        "group": "Terraform",
        "pages": [
          "infrastructure/terraform/overview",
          "infrastructure/terraform/quickstart",
          "infrastructure/terraform/authentication",
          "infrastructure/terraform/projects",
          "infrastructure/terraform/environments",
          "infrastructure/terraform/data-sources",
          "infrastructure/terraform/org-members"
        ]
      },
      {
        "group": "Testing",
        "pages": [
          "testing"
        ]
      },
      {
        "group": "Troubleshooting",
        "pages": [
          "troubleshooting"
        ]
      },
      {
        "group": "Migration",
        "pages": [
          "migration/v1",
          "migration/node-2",
          "openfeature"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/packages",
          "reference/http-api"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Console",
          "href": "https://app.fireweave.ai",
          "icon": "browser"
        },
        {
          "anchor": "SDK source",
          "href": "https://github.com/FireWeave-HQ/fireweave-sdk",
          "icon": "github"
        },
        {
          "anchor": "Terraform provider",
          "href": "https://registry.terraform.io/providers/FireWeave-HQ/fireweave/latest",
          "icon": "cube"
        }
      ]
    }
  },
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/FireWeave-HQ/fireweave-sdk"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/FireWeave-HQ/fireweave-sdk"
    }
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "og:site_name": "Fireweave Docs",
      "canonical": "https://docs.fireweave.ai"
    },
    "organization": {
      "id": "https://fireweave.ai/#organization",
      "name": "Fireweave",
      "url": "https://fireweave.ai",
      "sameAs": [
        "https://github.com/FireWeave-HQ",
        "https://docs.fireweave.ai"
      ]
    }
  },
  "search": {
    "prompt": "Search Fireweave docs"
  },
  "metadata": {
    "timestamp": true
  }
}
